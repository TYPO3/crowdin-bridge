{
	"name": "typo3/crowdin-bridge",
	"description": "Bridge for Crowdin->TYPO3",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Georg Ringer",
			"email": "georg.ringer@gmail.com"
		}
	],
	"config": {
		"bin-dir": "bin",
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"php-http/discovery": true,
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"sort-packages": true
	},
	"require": {
		"php": "^8.3",
		"ext-json": "*",
		"ext-zip": "*",
		"crowdin/crowdin-api-client": "^1.4",
		"symfony/console": "^7",
		"symfony/dependency-injection": "7.1.*",
		"symfony/dotenv": "^7.1",
		"symfony/filesystem": "^7.0",
		"symfony/finder": "^7",
		"symfony/flex": "^2",
		"symfony/framework-bundle": "7.1.*",
		"symfony/monolog-bundle": "^3.10",
		"symfony/runtime": "7.1.*",
		"symfony/yaml": "7.1.*",
		"typo3fluid/fluid": "^2.6"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.58"
	},
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"scripts": {
		"auto-scripts": {
			"cache:clear": "symfony-cmd",
			"assets:install %PUBLIC_DIR%": "symfony-cmd"
		},
		"post-install-cmd": [
			"@auto-scripts"
		],
		"post-update-cmd": [
			"@auto-scripts"
		],
		"cs": [
			"./bin/php-cs-fixer fix -v --dry-run --config .build/php-cs-fixer.php"
		],
		"csfix": [
			"./bin/php-cs-fixer fix --config .build/php-cs-fixer.php"
		]
	},
	"conflict": {
		"symfony/symfony": "*"
	},
	"extra": {
		"symfony": {
			"allow-contrib": false,
			"require": "7.1.*"
		}
	}
}
